generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum PaidStatusName {
  paid
  partial
  pending
}

enum ExamStatusName {
  draft
  ongoing
  finished
  cancelled
}

enum QuestionType {
  four_answer
  boolean
  descriptive
}

enum NotificationType {
  exam
  payment
  session
  announcement
  general
}

enum RecipientType {
  employee
  student
}

enum AnnouncementTarget {
  all
  class
  cycle
  employee
}

enum AuditAction {
  create
  update
  delete
  login
  grade
}
